# ─────────────────────────────────────────────────────────────
#  EtherBallot Server — Environment Variables Template
#  Copy this file to .env and fill in your own values.
#  NEVER commit the real .env to version control.
# ─────────────────────────────────────────────────────────────

# Server
PORT=5000
NODE_ENV=development

# MongoDB (leave MONGODB_URI blank to use embedded fallback DB)
MONGODB_URI=mongodb://127.0.0.1:27017/etherballot

# JWT — generate a secure 64-byte random hex string:
#   node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=CHANGE_ME_TO_A_64_BYTE_RANDOM_HEX_STRING
JWT_EXPIRE=7d

# CORS — comma-separated list of allowed origins for the API
CLIENT_URL=http://localhost:5173,http://127.0.0.1:5173

# Super Admin Seed Credentials (used on first boot only)
# CHANGE THESE BEFORE PRODUCTION DEPLOYMENT
SUPER_ADMIN_USERNAME=superadmin
SUPER_ADMIN_PASSWORD=Admin@123456
SUPER_ADMIN_NAME=Super Administrator
SUPER_ADMIN_EMAIL=admin@etherballot.com

# ─────────────────────────────────────────────────────────────
#  Transactional Email Provider Configuration
#  Supported: Resend, SendGrid, Amazon SES, Brevo, Postmark, Custom SMTP
#  (Leave blank in development to auto-provision an Ethereal test inbox)
# ─────────────────────────────────────────────────────────────
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your-email@example.com
SMTP_PASS=your-app-password
EMAIL_FROM="EtherBallot Election Commission <no-reply@etherballot.gov.in>"
APP_URL=http://localhost:5173

