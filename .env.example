# Server
PORT=5000
NODE_ENV=development
MONGODB_URI=mongodb://127.0.0.1:27017/etherballot
JWT_SECRET=change_me_min_32_chars
JWT_EXPIRE=7d
CLIENT_URL=http://localhost:5173

# Super Admin (seeded on first boot)
SUPER_ADMIN_USERNAME=superadmin
SUPER_ADMIN_PASSWORD=change_me_strong_password
SUPER_ADMIN_NAME=Super Administrator
SUPER_ADMIN_EMAIL=admin@example.com

# Gmail SMTP — use a Gmail App Password (not your login password)
# https://myaccount.google.com/apppasswords
SMTP_SERVICE=gmail
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=your_gmail@gmail.com
SMTP_PASS=your_16_char_app_password
EMAIL_FROM="EtherBallot <your_gmail@gmail.com>"
APP_URL=http://localhost:5173

# Client (Vite)
VITE_APP_NAME=EtherBallot
VITE_APP_VERSION=2.0.0
VITE_API_URL=