{
  "name": "etherballot",
  "version": "2.0.0",
  "description": "Blockchain-based secure voting system with face recognition — EtherBallot v2",
  "scripts": {
    "server": "cd server && npm run dev",
    "client": "cd client && npm run dev",
    "dev": "concurrently --names SERVER,CLIENT --prefix-colors blue,green \"npm run server\" \"npm run client\"",
    "install-all": "npm install && cd server && npm install && cd ../client && npm install",
    "build": "cd client && npm run build",
    "admin:seed": "cd server && node seed-admin.js",
    "start:server": "cd server && npm start",
    "lint": "cd client && npx eslint src --ext .js,.jsx"
  },
  "dependencies": {
    "concurrently": "^9.1.0"
  },
  "workspaces": [
    "server",
    "client"
  ],
  "overrides": {
    "cross-spawn": "^7.0.6",
    "micromatch": "^4.0.8",
    "braces": "^3.0.3",
    "nanoid": "^3.3.8",
    "path-to-regexp": "^0.1.10",
    "cookie": "^0.7.2",
    "ws": "^8.21.0",
    "body-parser": "^1.20.3",
    "send": "^0.19.0",
    "serve-static": "^1.16.2",
    "express": "^4.21.2",
    "axios": "^1.7.9",
    "vite": "^5.4.14",
    "qs": "^6.16.0",
    "node-fetch": "^2.6.7",
    "esbuild": "^0.25.0",
    "chokidar": "^3.6.0",
    "nodemon": "^3.1.9"
  }
}
