# ─────────────────────────────────────────────────────────────
#  EtherBallot Client — Environment Variables Template
#  Copy this file to .env and fill in your own values.
#  Vite exposes only variables prefixed with VITE_ to the browser.
# ─────────────────────────────────────────────────────────────

# Backend API base URL (used by api.js)
# In development, Vite proxy handles /api so this is not needed.
# Uncomment and set for production builds:
# VITE_API_URL=https://api.etherballot.com

# App metadata
VITE_APP_NAME=EtherBallot
VITE_APP_VERSION=2.0.0
